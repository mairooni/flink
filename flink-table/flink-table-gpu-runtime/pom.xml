<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.apache.flink</groupId>
		<artifactId>flink-table</artifactId>
		<version>2.3.0</version>
	</parent>

	<artifactId>flink-table-gpu-runtime</artifactId>
	<name>Flink : Table : GPU runtime</name>

	<description>
		Query-independent runtime for GPU offload of Flink SQL operators: kernels, gather
		strategies, the staging operator, and the provider the planner discovers by ServiceLoader.

		Not part of the default build. It depends on TornadoVM, which is not published to Maven
		Central and must be installed locally from a TornadoVM distribution, so building it
		unconditionally would break a clean checkout. Activate with -Pgpu.
	</description>

	<properties>
		<tornado.version>6.0.1-jdk21-dev</tornado.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-common</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
		<!--
			Carries the GpuOperatorFactoryProvider SPI and GpuCalcSpec. Deliberately not
			flink-table-planner: Flink's build bans direct dependencies on it, and the contract
			between planner and device runtime has no business referring to Calcite anyway.
		-->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-runtime</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
		<!--
			TornadoVM. Install from a TornadoVM distribution before building this module.

			Changing this version requires a clean build of this module, not an incremental one.
			TornadoVM resolves a kernel from its method reference's SerializedLambda, so the
			writeReplace() that makes that possible is emitted into the calling class at compile
			time against a specific tornado-api. Maven will not recompile unchanged sources for a
			dependency version bump, and the stale classes then fail at run time with
			"Kernel entry ... has no writeReplace()".

			  D=$TORNADO_SDK/share/java/tornado
			  for a in tornado-api tornado-annotation; do
			    mvn install:install-file -Dfile=$D/$a-5.2.1-jdk21-dev.jar \
			      -DgroupId=uk.ac.manchester.tornado -DartifactId=$a \
			      -Dversion=5.2.1-jdk21-dev -Dpackaging=jar
			  done
		-->
		<dependency>
			<groupId>uk.ac.manchester.tornado</groupId>
			<artifactId>tornado-api</artifactId>
			<version>${tornado.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>uk.ac.manchester.tornado</groupId>
			<artifactId>tornado-annotation</artifactId>
			<version>${tornado.version}</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!--
						Overrides the repository-wide source level 11. TornadoVM's off-heap array
						types are built on java.lang.foreign, a preview API on JDK 21, so this
						module cannot compile at the level the rest of the project uses.
					-->
					<!--
						source/target rather than release: the parent supplies add-exports
						compiler arguments, which javac rejects alongside the release flag.
					-->
					<source>21</source>
					<target>21</target>
					<compilerArgs combine.children="append">
						<arg>--enable-preview</arg>
					</compilerArgs>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
